{
  "name": "@afkzona/roster",
  "version": "0.1.0",
  "description": "Builds and validates the DORA register of information (Regulation (EU) 2022/2554, Article 28(3); Implementing Regulation (EU) 2024/2956) and writes the xBRL-CSV report package of the EBA DORA taxonomy 4.0. Offline, zero runtime dependencies.",
  "license": "AGPL-3.0-only",
  "author": "MB AFKzona Group",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afkzonagroup/roster.git"
  },
  "homepage": "https://github.com/afkzonagroup/roster#readme",
  "bugs": {
    "url": "https://github.com/afkzonagroup/roster/issues"
  },
  "keywords": [
    "dora",
    "register-of-information",
    "regulation-2022-2554",
    "its-2024-2956",
    "xbrl-csv",
    "eba",
    "ict-third-party-risk",
    "offline"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "bin": {
    "roster": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "LICENSE",
    "LICENSE-ADDITIONAL-TERMS.md",
    "COMMERCIAL.md",
    "TRADEMARKS.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-app.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "sources:fetch": "node scripts/fetch-sources.ts",
    "taxonomy:generate": "node scripts/generate-taxonomy.ts",
    "vectors:generate": "node scripts/generate-vectors.ts",
    "prepack": "npm run build",
    "docs:coverage": "node scripts/generate-coverage.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
